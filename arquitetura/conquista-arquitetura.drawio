          <mxGeometry x="420" y="410" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ov-pb" value="projetos-base&#10;(compactador — snapshots .db + este diagrama)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="610" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ov-e1" value="1. postMessage(CONQUISTA_TOKEN)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#2E7D32;" edge="1" parent="1" source="ov-sf" target="ov-home">
          <mxGeometry relative="1" as="geometry" />
