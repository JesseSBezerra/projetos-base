        <mxCell id="bff-title" value="BFF — API Gateway (contrato) + Backend em EKS" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bff-subtitle" value="Repos: preparacao-conquista-bff-contract (Gateway) + preparacao-conquista-bff (Spring Boot, EKS)" style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bff-col-gw" value="AWS API Gateway (preparacao-conquista-bff-contract)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#EF6C00;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#EF6C00;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="340" height="680" as="geometry" />
        </mxCell>
        <mxCell id="bff-token" value="POST /oauth/token&#10;Lambda token-issuer&#10;JWT HS256, client_credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bff-authorizer" value="Lambda Authorizer (REQUEST)&#10;valida JWT + scope&#10;token inválido → 403 · ausente → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bff-perf" value="Achado de performance:&#10;authorizerResultTtlInSeconds hoje = 0 (sem cache) —&#10;recomendação 300s AINDA NÃO aplicada&#10;(esperando token_ttl_seconds voltar a 3600s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=9;dashed=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="255" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bff-endpoints" value="GET /health (público)&#10;GET /usuario/{codigoUsuario}&#10;GET /grupo-economico?cnpj=&#10;GET /pipeline/em-atraso|hoje|proximos-dias&#10;POST /visitas (Visita__c + Event__c opcional)&#10;— não conectado ao home-c2 ainda, uso manual/futuro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="325" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bff-cors" value="CORS: preflight MOCK por operação +&#10;x-amazon-apigateway-gateway-responses&#10;(Access-Control-Allow-Origin nos erros do próprio Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="455" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bff-validator" value="x-amazon-apigateway-request-validator&#10;valida PRESENÇA de params, não `pattern`&#10;(limitação do próprio API Gateway REST v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="280" height="55" as="geometry" />
        </mxCell>
