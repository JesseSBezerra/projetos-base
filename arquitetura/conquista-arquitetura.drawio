          <mxGeometry x="60" y="350" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ov-eks" value="Backend em EKS&#10;preparacao-conquista-bff (Spring Boot)&#10;(ver página &quot;BFF&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ov-data" value="Salesforce — Dados / REST API&#10;Visita__c, Event__c, PerfilTabulacao__c...&#10;(ver página &quot;Salesforce&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="260" height="70" as="geometry" />
