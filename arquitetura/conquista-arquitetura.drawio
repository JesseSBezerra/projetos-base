  <!-- ======================================================================
       PÁGINA 2 — SALESFORCE
  ======================================================================= -->
  <diagram name="Salesforce" id="pagina-salesforce">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sf-title" value="Salesforce — LWC, Apex e Dados" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sf-subtitle" value="Repositório organizacao — projeto sfdx. Ver conquista-auth-lwc.db em projetos-base para o recorte só destas peças." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sf-col-apex" value="LWC + Apex (autenticação)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1565C0;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="320" height="600" as="geometry" />
        </mxCell>
        <mxCell id="sf-lwc" value="LWC homeC2Embed&#10;hospeda o iframe do home-c2&#10;handleMessage: HOME_C2_READY / REQUEST_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sf-controller" value="Apex: TV2_PB_ConquistaController&#10;obterToken() — usado pelo LWC&#10;autenticar() — diagnóstico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sf-service" value="Apex: TV2_PB_ConquistaService&#10;getBearerToken() — cache por transação&#10;POST /oauth/token (client_credentials)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="275" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sf-restresource" value="Apex: TV2_PB_ConquistaRestResource&#10;/services/apexrest/conquista/token&#10;(endpoint REST de diagnóstico manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sf-tests" value="Testes: *Test.cls (HttpCalloutMock)&#10;um por classe acima" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="415" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sf-nc" value="Named Credential&#10;Conquista_Gateway_API (protocolo NoAuthentication —&#10;auth manual no Apex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sf-cmdt" value="Custom Metadata&#10;Conquista_Gateway_Setting__mdt&#10;(Client_Id__c / Client_Secret__c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sf-permset" value="Permission Set&#10;TV2_PB_Conquista_Acesso&#10;(Apex Class Access — sem isso, LWC falha silencioso)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sf-csp" value="CSP Trusted Site&#10;Home_C2_AWS_Frontend&#10;(libera o domínio CloudFront pro iframe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="675" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="sf-col-dados" value="Dados (objetos consultados/gravados)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1565C0;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="sf-visita" value="Visita__c&#10;Objeto EMPACOTADO de terceiros (~150 campos, app de&#10;força de vendas) — só um subconjunto é usado aqui:&#10;OwnerId, Conta__c/Lead__c, CNPJ_ESTABELECIMENTO__c,&#10;TipoContato__c/StatusContato__c/StatusDetalhado__c,&#10;Observacoes__c, RealizadoPor__c, EventId__c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="120" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sf-event" value="Event__c&#10;Objeto CUSTOM PRÓPRIO (só 4 campos):&#10;StartDateTime__c, EndDateTime__c,&#10;Subtipo__c (&quot;Retornar Visita/Ligação/WhatsApp&quot;),&#10;TipoDoContato__c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="265" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sf-relacao" value="Visita__c.EventId__c → Event__c&#10;(data/hora/tipo do retorno ficam no Event, não na Visita —&#10;convenção herdada, não um bug novo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="380" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sf-perfiltab" value="PerfilTabulacao__c&#10;Árvore de decisão do Pipeline (dado externalizado,&#10;não hardcoded): TipoContato__c × StatusContato__c ×&#10;StatusDetalhado__c → Pipeline__c.&#10;38 linhas cadastradas, 18 elegíveis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="450" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sf-outros" value="Account (RazaoSocial__c, CNPJ_TEMP__c, CNPJCabeca__c) /&#10;Lead (CNPJ__c) / User (Nome_Perfil__c — filtro de perfil&#10;do tabulador, &quot;TV - Executivo Conquista&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="575" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sf-regra33" value="Regra 3.3 (restrição por perfil do tabulador) —&#10;DELIBERADAMENTE NÃO implementada&#10;(campo não confiável na época, ver duvidas-implementacao.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="655" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="sf-col-fluxo" value="Fluxo de autenticação (resumo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#2E7D32;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="sf-fluxo1" value="1. LWC dispara HOME_C2_READY / REQUEST_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="120" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sf-fluxo2" value="2. Controller.obterToken() → Service.getBearerToken()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="170" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sf-fluxo3" value="3. Named Credential → POST /oauth/token (Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="220" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sf-fluxo4" value="4. Bearer JWT volta pro LWC → postMessage(CONQUISTA_TOKEN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="270" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sf-fluxo5" value="5. home-c2 usa o token nas chamadas ao Gateway&#10;(ver página &quot;Microfrontend&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="330" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sf-e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sf-lwc" target="sf-controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sf-e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sf-controller" target="sf-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sf-e3" value="usa" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="sf-service" target="sf-nc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sf-e4" value="lê" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="sf-service" target="sf-cmdt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sf-e5" value="requer" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" parent="1" source="sf-controller" target="sf-permset">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
