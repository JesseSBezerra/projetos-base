        <mxCell id="ov-e2" value="2. Authorization: Bearer JWT&#10;(cadeia de auth #1 — Gateway)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#EF6C00;" edge="1" parent="1" source="ov-home" target="ov-gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e3" value="3. VPC Link / NLB (http_proxy)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#6A1B9A;" edge="1" parent="1" source="ov-gw" target="ov-eks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e4" value="4. Bearer TV2-STS&#10;(cadeia de auth #2 — independente)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#1565C0;" edge="1" parent="1" source="ov-eks" target="ov-data">
          <mxGeometry relative="1" as="geometry" />
