  <!-- ======================================================================
       PÁGINA 3 — MICROFRONTEND (home-c2)
  ======================================================================= -->
  <diagram name="Microfrontend (home-c2)" id="pagina-microfrontend">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="mf-title" value="Microfrontend — home-c2 (Angular 18)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mf-subtitle" value="Roda dentro de um &lt;iframe&gt; hospedado pelo LWC homeC2Embed. Nunca fala com Salesforce nem com o backend diretamente — só com o API Gateway." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="mf-col-auth" value="Autenticação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#2E7D32;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="mf-auth" value="AuthService&#10;recebe CONQUISTA_TOKEN via postMessage,&#10;guarda token/userId SÓ EM MEMÓRIA (BehaviorSubject)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf-renov" value="solicitarNovoToken()&#10;postMessage(REQUEST_TOKEN) — renovação&#10;quando o token expira (~1h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="195" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mf-interceptor" value="auth.interceptor.ts&#10;anexa Authorization: Bearer + x-conquista-*&#10;retry automático em 401/403 (1x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="265" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mf-origins" value="ALLOWED_ORIGINS&#10;domínio Lightning esperado (My Domain) —&#10;origem não confiável = mensagem descartada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="335" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="mf-col-servicos" value="Services / Pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#2E7D32;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="320" height="600" as="geometry" />
        </mxCell>
        <mxCell id="mf-usuario" value="UsuarioApiService&#10;GET /usuario/{codigoUsuario}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="120" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mf-pipeline" value="PipelineApiService&#10;GET /pipeline/em-atraso|hoje|proximos-dias&#10;getItensBrutos() (usado também pela Agenda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="180" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mf-agenda" value="AgendaApiService&#10;SEM endpoint próprio — reaproveita PipelineApiService&#10;agrupando por data em vez de por etapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="260" height="55" as="geometry" />
        </mxCell>
