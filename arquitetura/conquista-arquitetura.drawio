          <mxGeometry x="50" y="585" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bff-cicd-gw" value="CI/CD (deploy-gateway.yml):&#10;validate-contract (pytest) → bundle OpenAPI →&#10;terraform plan (PR) / apply (push main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
