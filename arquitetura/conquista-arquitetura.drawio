        </mxCell>
        <mxCell id="subtitle" value="Duas cadeias de autenticação independentes: (1) home-c2 → Gateway via OAuth2 client_credentials / JWT HS256 — validado pelo Lambda Authorizer.  (2) preparacao-conquista-bff → Salesforce via handshake TV2-STS (nunca chega ao consumidor)." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1200" height="20" as="geometry" />
        </mxCell>

