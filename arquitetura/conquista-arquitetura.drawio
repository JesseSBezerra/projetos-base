        </mxCell>
        <mxCell id="ov-subtitle" value="4 páginas neste arquivo: Visão Geral · Salesforce · Microfrontend (home-c2) · BFF (backend + API Gateway)" style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
