        <mxCell id="ov-e6" value="secrets" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;strokeColor=#C62828;" edge="1" parent="1" source="ov-eks" target="ov-secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ov-legend" value="Duas cadeias de autenticação totalmente independentes:&#10;#1 Consumidor (home-c2) → Gateway: OAuth2 client_credentials, JWT HS256, validado pelo Lambda Authorizer.&#10;#2 Backend (preparacao-conquista-bff) → Salesforce: handshake TV2-STS, nunca chega ao consumidor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
